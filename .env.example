# CodeGuard does NOT call any external LLM at inference time.
# No API keys are required to run it locally.

# --- optional hardening (all disabled/unset by default) -------------------
# Requests per minute per client (default 600, 0 disables the limiter).
# CODEGUARD_RATE_LIMIT=600

# Set to 0 to skip the startup warm-up (useful for fast tests/CI).
# CODEGUARD_WARMUP=1

# --- model location (defaults are repo-relative) --------------------------
# CODEGUARD_MODEL_PATH=
# CODEGUARD_MANIFEST_PATH=
